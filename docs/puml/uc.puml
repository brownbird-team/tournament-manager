' ================================================================
' BrownBird Tournament manager
'
' Dijagram prikazuje tko i s kojim ciljem koristi pojedine
' dijelove sustava.
'
' Made by BrownBird Team (progi edition)
' ================================================================

@startuml
title BrownBird Tournament Manager - slučajevi uporabe
left to right direction

skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #212529

skinparam actor {
  BackgroundColor #F8F9FA
  BorderColor #212529
  BackgroundColor<<external system>> #FFF3CD
  BorderColor<<external system>> #856404
}

skinparam usecase {
  BackgroundColor #E7F1FF
  BorderColor #0D6EFD
}

' ================================================================
' Primarni akteri
' ================================================================

actor User as "Korisnik"
actor Visitor as "Posjetitelj"
actor Admin as "Administrator"
actor Owner as "Vlasnik organizacije"
actor Competitor as "Natjecatelj"

Admin -|> Owner
Owner -|> User
User -|> Visitor
Competitor -up-|> User

' ================================================================
' Sekundarni akteri (vanjski sustavi)
' ================================================================

actor "Pružatelj identiteta" as Idp <<external system>>
actor "Steam API" as Steam <<external system>>
actor "Tetr.io Bot" as Tetrio <<external system>>

' ================================================================
' Granica sustava (slučajevi uporabe)
' ================================================================

rectangle "Tournament manager" as bbtm {
  ' Korisnički računi
  (UC-01 Prijava u sustav) as UC_login
  (UC-02 Inicijalizacija korisničkog računa) as UC_register
  (UC-03 Izmjena podataka o korisniku) as UC_user_settings
  (UC-07 Pretraga korisnika) as UC_user_search

  ' Organizacije
  (UC-04 Stvaranje nove organizacije) as UC_org_create
  (UC-05 Izmjena postavki organizacije) as UC_org_settings
  (UC-06 Brisanje organizacije) as UC_org_delete
  (UC-08 Pretraga organizacija) as UC_org_search
  (UC-11 Resetiranje API tokena organizacije) as UC_org_reset_token
  (UC-21 Izvršavanje akcija putem API-a) as UC_org_api

  ' Turniri
  (UC-09 Stvaranje novog turnira) as UC_tour_create
  (UC-10 Izmjena postavki turnira) as UC_tour_settings
  (UC-12 Prijava na turnir) as UC_tour_register
  (UC-13 Check-in na turnir) as UC_tour_check_in
  (UC-14 Odjava s turnira prije početka) as UC_tour_unregister
  (UC-15 Predaja tijekom turnira) as UC_tour_resign
  (UC-16 Izbacivanje natjecatelja s turnira) as UC_tour_kick
  (UC-17 Prijava rezultata meča) as UC_tour_report_result
  (UC-18 Komunikacija tijekom meča - chat) as UC_tour_chat
  (UC-19 Prijava problema tijekom meča) as UC_tour_report_problem
  (UC-22 Odgovor na prijavu problema tijekom meča) as UC_tour_problem_response
  (UC-23 Sudjelovanje u meču tijekom turnira) as UC_tour_compete

  ' Administracija
  (UC-20 Zabrana pristupa stranici) as UC_ban
}

' ================================================================
' Interakcije sa akterima
' ================================================================

Visitor -- UC_login
Visitor -- UC_user_search
Visitor -- UC_org_search

User -- UC_user_settings
User -- UC_org_create
User -- UC_tour_register

Owner -- UC_org_settings
Owner -- UC_org_delete
Owner -- UC_tour_create
Owner -- UC_tour_settings
Owner -- UC_tour_kick
Owner -- UC_tour_problem_response

Competitor -- UC_tour_check_in
Competitor -- UC_tour_unregister
Competitor -- UC_tour_resign
Competitor -- UC_tour_compete

Admin -- UC_ban

' ================================================================
' Veze između slučajeva uporabe
' ================================================================

UC_login ..> UC_register : <<include>>

UC_tour_compete <.. UC_tour_report_result : <<extend>>
UC_tour_compete <.. UC_tour_chat : <<extend>>
UC_tour_compete <.. UC_tour_report_problem : <<extend>>

UC_org_settings <.. UC_org_reset_token : <<extend>>
'UC_org_delete -[hidden]- UC_org_reset_token

' ================================================================
' Interakcije sa sekundarnim akterima
' ================================================================

Idp -up- UC_login
Idp -[hidden]up- UC_org_reset_token
Idp -[hidden]up- UC_user_search

Tetrio -up- UC_org_api
Tetrio -[hidden]up- UC_org_reset_token

Steam -up- UC_tour_settings
Steam -[hidden]up- UC_org_reset_token

@enduml