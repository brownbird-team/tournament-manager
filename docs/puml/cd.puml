@startuml
title BrownBird Tournament Manager - domenski model

skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam ArrowColor #212529

skinparam class {
    BackgroundColor #E7F1FF
    BorderColor #0D6EFD
}

skinparam note {
    BackgroundColor #F8F9FA
    BorderColor #212529
    FontColor #212529
}

package "Entities" {
    class User <<Entity>> {}
    class Organization <<Entity>> {}
    class ChatRoom <<Entity>> {}
    class ChatMessage <<Entity>> {}
    class Tournament <<Entity>> {}
    class Participant <<Entity>> {}
    class Match <<Entity>> {}
    
}

@enduml